generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ========================================
// ROOM STATUS
// ========================================

enum RoomStatus {
  READY
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

// ========================================
// PROPERTY
// ========================================

model Property {
  id          String  @id @default(cuid())
  name        String
  address     String
  city        String
  province    String
  country     String  @default("Philippines")
  phone       String?
  email       String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomTypes RoomType[]
}

// ========================================
// ROOM TYPE
// ========================================

model RoomType {
  id               String  @id @default(cuid())
  propertyId       String
  name             String
  description      String?
  capacity         Int
  baseRateCentavos Int
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  rooms        Room[]
  images       RoomImage[]
  amenities    RoomTypeAmenity[]
  reservations Reservation[]

  @@unique([propertyId, name])
}

// ========================================
// PHYSICAL ROOM
// ========================================

model Room {
  id         String     @id @default(cuid())
  roomTypeId String
  roomNumber String     @unique
  floor      String?
  status     RoomStatus @default(READY)
  isActive   Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomType        RoomType         @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  roomAssignments RoomAssignment[]
  roomBlocks      RoomBlock[]
}

// ========================================
// AMENITY
// ========================================

model Amenity {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomTypes RoomTypeAmenity[]
}

// ========================================
// ROOM TYPE AMENITY
// ========================================

model RoomTypeAmenity {
  roomTypeId String
  amenityId  String

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([roomTypeId, amenityId])
}

// ========================================
// ROOM IMAGE
// ========================================

model RoomImage {
  id           String  @id @default(cuid())
  roomTypeId   String
  filePath     String
  altText      String?
  displayOrder Int     @default(0)
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
}

// ========================================
// USER STATUS
// ========================================

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

// ========================================
// ROLE
// ========================================

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// ========================================
// USER
// ========================================

model User {
  id           String     @id @default(cuid())
  roleId       String
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  guest         Guest?
}

// ========================================
// REFRESH TOKEN
// ========================================

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// ========================================
// GUEST
// ========================================

model Guest {
  id        String  @id @default(cuid())
  userId    String? @unique
  firstName String
  lastName  String
  email     String?
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  reservations Reservation[]
}

// ========================================
// RESERVATION STATUS
// ========================================

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

// ========================================
// RESERVATION
// ========================================

model Reservation {
  id                String @id @default(cuid())
  reservationNumber String @unique

  guestId    String
  roomTypeId String

  // Philippine calendar dates, handled
  // consistently by the backend.
  checkInDate  DateTime
  checkOutDate DateTime

  // Includes the primary guest.
  guestCount Int

  // Monetary amounts are integer centavos.
  nightlyRateCentavos Int
  totalAmountCentavos Int

  status ReservationStatus @default(PENDING)

  // Optional temporary inventory hold.
  holdExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guest    Guest    @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  additionalGuests ReservationGuest[]
  roomAssignments  RoomAssignment[]

  @@index([guestId])
  @@index([roomTypeId, checkInDate, checkOutDate])
  @@index([status, holdExpiresAt])
}

// ========================================
// RESERVATION GUEST
// ========================================

model ReservationGuest {
  id            String @id @default(cuid())
  reservationId String

  firstName String
  lastName  String

  createdAt DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
}

// ========================================
// ROOM ASSIGNMENT
// ========================================

model RoomAssignment {
  id            String @id @default(cuid())
  reservationId String
  roomId        String

  assignedAt DateTime @default(now())

  // Null means this assignment has not
  // been released or replaced.
  releasedAt DateTime?

  createdAt DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([roomId])
}

// ========================================
// ROOM BLOCK
// ========================================

model RoomBlock {
  id     String @id @default(cuid())
  roomId String

  // Blocked Philippine calendar dates.
  startDate DateTime
  endDate   DateTime

  reason String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId, startDate, endDate])
}
