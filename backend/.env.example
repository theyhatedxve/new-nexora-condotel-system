# Local runtime
NODE_ENV=development

# Keep these URLs pointed at the same intended database.
# DATABASE_URL is used by Prisma CLI.
# NEXORA_RUNTIME_DATABASE_URL is used by the running application.
DATABASE_URL=file:D:/Web-JSX/NEXORA/backend/dev.db
NEXORA_RUNTIME_DATABASE_URL=file:D:/Web-JSX/NEXORA/backend/dev.db

# The current backend listens on port 3000.
AUTH_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5176

# Supply a private secret containing at least 32 bytes.
JWT_ACCESS_SECRET=

# Guest and staff email destinations
AUTH_VERIFY_URL=http://localhost:5175/verify-email
STAFF_SETUP_URL=http://localhost:5176/staff/setup-password
NEXORA_GUEST_WEB_URL=http://localhost:5175

# SMTP credentials for the approved development email service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# PayMongo test configuration
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_WEBHOOK_SECRET=
PAYMONGO_RETURN_URL=http://localhost:5175/payment-return
PAYMONGO_PAYMENT_METHODS=qrph

# Guest phone encryption
# Copy the existing key ID and complete key map into your private .env.
# Example JSON structure:
# {"phone-v1":"BASE64_ENCODED_32_BYTE_KEY"}
# Preserve every key required by existing encrypted records and backups.
NEXORA_GUEST_PHONE_ACTIVE_KEY_ID=phone-v1
NEXORA_GUEST_PHONE_KEYS='{}'

# Background processing is opt-in for the local startup baseline.
NEXORA_BOOKING_DEADLINE_WORKER_ENABLED=false
NEXORA_BOOKING_EMAIL_WORKER_ENABLED=false

# Uploaded room images
ROOM_IMAGE_STORAGE_DIR=D:/Web-JSX/NEXORA/storage/room-images

# Development seed permission
NEXORA_ALLOW_DEV_SEED=false